{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/retry-emails",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/request",
      "destination": "/api/request"
    },
    {
      "source": "/api/inquiry",
      "destination": "/api/inquiry"
    },
    {
      "source": "/api/webhooks/resend",
      "destination": "/api/webhooks/resend"
    },
    {
      "source": "/api/cron/retry-emails",
      "destination": "/api/cron/retry-emails"
    },
    {
      "source": "/api/admin/emails",
      "destination": "/api/admin/emails"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
