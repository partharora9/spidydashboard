  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run type-check && npm run build && npm run test:e2e",
    "preview": "vite preview",
    "server": "tsx server/src/server.ts",
    "test:backend": "tsx server/scripts/testSuite.ts",
    "stage:releases": "tsx server/scripts/uploadRelease.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "framer-motion": "^14.3.1",
    "helmet": "^8.3.0",
    "imap-simple": "^5.1.0",
    "lucide-react": "^1.59.0",
    "mailparser": "^3.9.47",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/imap-simple": "^4.2.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
