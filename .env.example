# ==============================================================================
# SPIDYDASHBOARD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file with secrets to GitHub or public repositories.
# ==============================================================================

# Application Environment
NODE_ENV=
PORT=
CLIENT_ORIGIN=

# Payment Configuration
MERCHANT_UPI_ID=
MERCHANT_NAME=
UNIQUE_AMOUNT_MATCHING=

# Database Configuration
DATABASE_URL=

# Admin Security Configuration
ADMIN_SECRET=
ADMIN_SESSION_SECRET=

# Storage & Email Configuration
STORAGE_PROVIDER=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=

# Email Provider Settings
EMAIL_PROVIDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=
GMAIL_AUTO_RESPONDER=

# Order & Token Expiry Settings
ORDER_EXPIRY_MINUTES=
DOWNLOAD_TOKEN_EXPIRY_MINUTES=
MAX_DOWNLOADS_PER_TOKEN=
OTP_EXPIRY_MINUTES=
