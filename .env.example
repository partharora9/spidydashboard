# ==============================================================================
# SPIDYDASHBOARD PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env or paste these into your Vercel Project Settings:
# Settings -> Environment Variables.
# NEVER commit real .env or secrets to Git or front-end client bundles!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND EMAIL & SENDER DOMAIN (Vercel Serverless Functions & Backend)
# ------------------------------------------------------------------------------
# API Key generated from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Your verified custom sending domain (e.g. spidydashboard.com)
MAIL_DOMAIN=spidydashboard.com

# Owner's personal inbox (receives lead & order alerts). NEVER exposed to frontend!
OWNER_EMAIL=partharora06e@gmail.com

# Sender identity for owner operational alerts (uses dedicated mail subdomain)
FROM_REQUESTS="SpidyDashboard <requests@mail.spidydashboard.com>"

# Sender identity for buyer confirmation receipts
FROM_HELLO="SpidyDashboard <hello@mail.spidydashboard.com>"

# Monitored reply-to address for buyer replies (forwarded to OWNER_EMAIL)
REPLY_TO_HELLO=parthxcore@gmail.com

# Fallback email sender address
EMAIL_FROM="SpidyDashboard <parthxcore@gmail.com>"

# Primary email provider: 'resend', 'gmail', 'ses', or 'console' (defaults to 'resend')
EMAIL_PROVIDER=resend

# Resend Svix webhook signing secret from Resend Webhooks dashboard (format: whsec_...)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 2. UPI PAYMENT CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# Merchant UPI VPA receiving student payments (defaults safely to 8700383626@axl)
MERCHANT_UPI_ID=8700383626@axl

# Merchant display name shown on UPI app payment screens
MERCHANT_NAME="Parth Arora"

# Unique amount matching flag (true / false)
UNIQUE_AMOUNT_MATCHING=true

# ------------------------------------------------------------------------------
# 3. SECONDARY ZERO-PII NOTIFICATION CHANNEL (INSTANT OWNER NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Option A: ntfy.sh topic (Subscribe via ntfy mobile app or web)
NTFY_TOPIC=spidydashboard-requests-secret123

# Option B: Telegram Bot (Optional alternative to ntfy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. SYSTEM, ADMIN & CRON SECURITY
# ------------------------------------------------------------------------------
# Secret key protecting the admin deliverability dashboard and order verification (min 16 chars)
ADMIN_SECRET=dev-admin-secret-key-32-chars-long!

# Admin session cookie secret
ADMIN_SESSION_SECRET=super-secret-session-key-32chars-min!

# Secret key passed in Authorization header for Vercel Cron jobs (/api/cron/retry-emails)
CRON_SECRET=cron_secret_key_matching_vercel_crons

# Cloudflare Turnstile bot verification secret key (Optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated list of allowed IP addresses for Admin Console (Optional)
ADMIN_ALLOWED_IPS=

# Admin alert recipient email for order submissions
ADMIN_ALERT_EMAIL=partharora06e@gmail.com

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & STORAGE (FOR STANDALONE EXPRESS SERVER)
# ------------------------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database URL (PostgreSQL / Supabase - Optional; in-memory store used by default)
DATABASE_URL=

# Storage Provider for release files: 'local', 's3', or 'r2'
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET_NAME=spidydashboard-releases
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Optional Gmail SMTP fallback
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_AUTO_RESPONDER=false

# Order and token timing rules
ORDER_EXPIRY_MINUTES=30
DOWNLOAD_TOKEN_EXPIRY_MINUTES=2880
MAX_DOWNLOADS_PER_TOKEN=3
OTP_EXPIRY_MINUTES=10
