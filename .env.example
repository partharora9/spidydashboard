# ==============================================================================
# SPIDYDASHBOARD PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env or paste these into your Vercel Project Settings:
# Settings -> Environment Variables.
# NEVER commit the real .env or secrets to Git or front-end client bundles!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND EMAIL & SENDER DOMAIN (STEP 0 & STEP 2)
# ------------------------------------------------------------------------------
# API Key generated from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Your verified custom sending domain (e.g. spidydashboard.com)
MAIL_DOMAIN=spidydashboard.com

# Owner's personal inbox (receives order notifications). NEVER exposed to frontend!
OWNER_EMAIL=your-inbox@gmail.com

# Sender identity for owner operational alerts (uses dedicated mail subdomain)
FROM_REQUESTS="SpidyDashboard <requests@mail.spidydashboard.com>"

# Sender identity for buyer confirmation receipts
FROM_HELLO="SpidyDashboard <hello@mail.spidydashboard.com>"

# Monitored reply-to address for buyer replies (forwarded to OWNER_EMAIL)
REPLY_TO_HELLO=hello@spidydashboard.com

# ------------------------------------------------------------------------------
# 2. RESEND WEBHOOK SECURITY (STEP 2)
# ------------------------------------------------------------------------------
# Svix signing secret from Resend Webhooks dashboard (format: whsec_...)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 3. SECONDARY ZERO-PII NOTIFICATION CHANNEL (STEP 2)
# Guarantees you receive alerts even if email hits spam or network drops.
# ------------------------------------------------------------------------------
# Option A: ntfy.sh topic (Subscribe via ntfy mobile app or web)
NTFY_TOPIC=spidydashboard-requests-secret123

# Option B: Telegram Bot (Optional alternative to ntfy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. SYSTEM & CRON SECURITY
# ------------------------------------------------------------------------------
# Secret key protecting the admin deliverability dashboard and retry cron
ADMIN_SECRET=dev-admin-secret-key-32-chars-long!
CRON_SECRET=cron_secret_key_matching_vercel_crons

# Cloudflare Turnstile bot verification (Optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
